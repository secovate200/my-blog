# 문의 알림용 Discord 웹후크
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# 회원가입 승인 요청 알림용 Discord 웹후크
DISCORD_SIGNUP_WEBHOOK_URL=https://discord.com/api/webhooks/your-signup-webhook-id/your-signup-webhook-token
# 장애 알림 전용 Discord 웹후크(OpenObserve Destination에 등록)
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-alert-webhook-id/your-alert-webhook-token
WAF_DISCORD_COOLDOWN_SECONDS=60

# OpenObserve: 반드시 실제 운영용 이메일과 강한 비밀번호로 변경하세요.
# 기본값은 로컬 PC에서만 로그 관리 화면에 접근할 수 있게 제한합니다.
OPENOBSERVE_BIND_ADDRESS=127.0.0.1
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=change-this-password
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=blog_logs
OPENOBSERVE_RETENTION_DAYS=14
OBSERVABILITY_ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,waf
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
DASHBOARD_LOGIN_URL=http://localhost:5175/#/login
DASHBOARD_FORBIDDEN_URL=http://localhost:5175/#/403
BLOG_FRONTEND_URL=http://localhost:5173
VITE_DASHBOARD_URL=http://localhost:5175

# WAF는 먼저 탐지만 수행합니다. 로그 확인 후 On으로 바꾸면 차단도 활성화됩니다.
WAF_MODE=DetectionOnly
WAF_BLOCKING_PARANOIA=1
WAF_DETECTION_PARANOIA=2
WAF_INBOUND_THRESHOLD=5
WAF_OUTBOUND_THRESHOLD=4

# SMTP 메일 서버 설정 예시(Gmail은 앱 비밀번호를 사용하세요).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=SECOVATE200 BLOG <your-email@gmail.com>
