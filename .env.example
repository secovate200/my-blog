# 문의 알림용 Discord 웹후크
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# 회원가입 승인 요청 알림용 Discord 웹후크
DISCORD_SIGNUP_WEBHOOK_URL=https://discord.com/api/webhooks/your-signup-webhook-id/your-signup-webhook-token
# 장애 알림 전용 Discord 웹후크(OpenObserve Destination에 등록)
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-alert-webhook-id/your-alert-webhook-token
WAF_DISCORD_COOLDOWN_SECONDS=60

# OpenObserve: 반드시 실제 운영용 이메일과 강한 비밀번호로 변경하세요.
# 기본값은 로컬 PC에서만 로그 관리 화면에 접근할 수 있게 제한합니다.
OPENOBSERVE_BIND_ADDRESS=127.0.0.1
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=change-this-password
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=blog_logs
OPENOBSERVE_RETENTION_DAYS=14
OBSERVABILITY_ENVIRONMENT=production

# Django 운영 보안 설정: SECRET_KEY는 아래 명령처럼 별도로 생성해 절대 커밋하지 마세요.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-production-secret
DJANGO_ALLOWED_HOSTS=blog.example.com,dashboard.example.com,backend,waf
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false

# 외부 공개 주소와 바인딩 범위입니다. 대시보드는 기본적으로 로컬에서만 접근됩니다.
BLOG_FRONTEND_URL=https://blog.example.com
VITE_DASHBOARD_URL=https://dashboard.example.com
DASHBOARD_LOGIN_URL=https://dashboard.example.com/#/login
DASHBOARD_FORBIDDEN_URL=https://dashboard.example.com/#/403
BLOG_BIND_ADDRESS=0.0.0.0
BLOG_PORT=5173
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=5175
WAF_PORT=8000

# 운영 배포는 차단 모드를 사용합니다. 배포 전 스테이징에서 오탐을 먼저 확인하세요.
WAF_MODE=On
WAF_BLOCKING_PARANOIA=1
WAF_DETECTION_PARANOIA=2
WAF_INBOUND_THRESHOLD=5
WAF_OUTBOUND_THRESHOLD=4

# SMTP 메일 서버 설정 예시(Gmail은 앱 비밀번호를 사용하세요).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=SECOVATE200 BLOG <your-email@gmail.com>
